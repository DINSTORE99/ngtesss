@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap");


/* =========================================================
   RESET
========================================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-width: 320px;

  background: #f5f6e8;

  color: #111;

  font-family: "Inter", sans-serif;

  overflow-x: hidden;
}

button,
input {
  font-family: inherit;
}

button {
  color: inherit;
}

button:focus-visible,
input:focus-visible {
  outline: 3px solid #79e3a5;
  outline-offset: 3px;
}


/* =========================================================
   APP
========================================================= */

.app {
  min-height: 100vh;

  position: relative;

  overflow-x: hidden;

  background:
    radial-gradient(
      circle at 80% 0%,
      rgba(121, 227, 165, 0.25),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      #fafbea 0%,
      #f5f6e8 50%,
      #eef7ed 100%
    );
}


/* =========================================================
   BACKGROUND GRID
========================================================= */

.app::before {
  content: "";

  position: fixed;

  inset: 0;

  background-image:
    linear-gradient(
      rgba(17, 17, 17, 0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(17, 17, 17, 0.035) 1px,
      transparent 1px
    );

  background-size: 42px 42px;

  pointer-events: none;

  z-index: 0;
}


/* =========================================================
   HEADER
========================================================= */

.header {
  position: sticky;

  top: 0;

  width: 100%;

  height: 76px;

  display: flex;
  align-items: center;

  background: #79e3a5;

  border-bottom: 4px solid #111;

  z-index: 100;
}

.header-inner {
  width: 100%;
  height: 100%;

  display: flex;
  align-items: center;

  padding: 0 22px;
}


/* =========================================================
   3D MENU
========================================================= */

.menu-button {
  width: 46px;
  height: 46px;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  gap: 5px;

  background: #fff;

  border: 3px solid #111;

  border-radius: 13px;

  box-shadow:
    4px 4px 0 #111;

  cursor: pointer;

  transition:
    transform 0.12s ease,
    box-shadow 0.12s ease;
}

.menu-button span {
  width: 21px;
  height: 3px;

  display: block;

  background: #111;

  border-radius: 10px;
}

.menu-button:hover {
  transform: translate(-2px, -2px);

  box-shadow:
    6px 6px 0 #111;
}

.menu-button:active,
.menu-button.active {
  transform: translate(3px, 3px);

  box-shadow:
    1px 1px 0 #111;
}


/* =========================================================
   OVERLAY
========================================================= */

.nav-overlay {
  position: fixed;

  inset: 0;

  background: rgba(17, 17, 17, 0.45);

  opacity: 0;

  visibility: hidden;

  transition:
    opacity 0.25s ease,
    visibility 0.25s ease;

  z-index: 150;
}

.nav-overlay.show {
  opacity: 1;

  visibility: visible;
}


/* =========================================================
   SIDE NAV
========================================================= */

.side-nav {
  position: fixed;

  top: 0;
  left: 0;

  width: 430px;

  max-width: 88vw;

  height: 100vh;

  padding: 32px 24px;

  background: #f8f9e9;

  border-right: 4px solid #111;

  transform: translateX(-105%);

  transition:
    transform 0.35s cubic-bezier(.2,.8,.2,1);

  z-index: 200;

  overflow-y: auto;

  box-shadow:
    12px 0 0 rgba(17, 17, 17, 0.08);
}

.side-nav.open {
  transform: translateX(0);
}


/* =========================================================
   SIDE NAV HEADER
========================================================= */

.side-nav-header {
  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  gap: 20px;

  padding-bottom: 24px;

  border-bottom: 4px solid #111;
}

.nav-label {
  display: block;

  margin-bottom: 8px;

  color: #666;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 4px;
}

.side-nav-header h2 {
  font-size: 25px;

  font-weight: 900;

  letter-spacing: -1px;
}


/* =========================================================
   CLOSE
========================================================= */

.close-button {
  width: 48px;
  height: 48px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #fff;

  border: 3px solid #111;

  border-radius: 13px;

  box-shadow:
    4px 4px 0 #111;

  font-size: 29px;

  cursor: pointer;

  transition:
    transform 0.12s ease,
    box-shadow 0.12s ease;
}

.close-button:hover {
  transform: translate(-2px, -2px);

  box-shadow:
    6px 6px 0 #111;
}

.close-button:active {
  transform: translate(3px, 3px);

  box-shadow:
    1px 1px 0 #111;
}


/* =========================================================
   NAV ITEMS
========================================================= */

.nav-items {
  display: flex;

  flex-direction: column;

  gap: 12px;

  padding-top: 24px;
}

.nav-item {
  width: 100%;

  min-height: 62px;

  display: flex;

  align-items: center;

  gap: 14px;

  padding: 13px 16px;

  background: #fff;

  border: 3px solid #111;

  border-radius: 16px;

  box-shadow:
    4px 4px 0 #111;

  cursor: pointer;

  text-align: left;

  transition:
    transform 0.12s ease,
    box-shadow 0.12s ease,
    background 0.12s ease;
}

.nav-item:hover {
  background: #e9fff0;

  transform: translate(-2px, -2px);

  box-shadow:
    6px 6px 0 #111;
}

.nav-item:active {
  transform: translate(3px, 3px);

  box-shadow:
    1px 1px 0 #111;
}

.nav-item > span {
  width: 27px;

  display: flex;

  justify-content: center;

  font-size: 20px;
}

.nav-item b {
  flex: 1;

  font-size: 13px;

  font-weight: 900;

  letter-spacing: 1.5px;
}

.nav-item small {
  color: #888;

  font-size: 10px;

  font-weight: 800;
}

.nav-item.home {
  background: #79e3a5;
}


/* =========================================================
   MAIN
========================================================= */

.main {
  position: relative;

  z-index: 2;

  width: min(
    1080px,
    calc(100% - 40px)
  );

  margin: 0 auto;

  padding: 70px 0 100px;
}


/* =========================================================
   HERO
========================================================= */

.hero {
  padding-top: 10px;
}


/* =========================================================
   TERMINAL
========================================================= */

.terminal-badge {
  width: fit-content;

  display: inline-flex;

  align-items: center;

  gap: 9px;

  padding: 9px 17px;

  background: #ffe06a;

  border: 3px solid #111;

  border-radius: 999px;

  box-shadow:
    4px 4px 0 #111;

  font-size: 11px;

  font-weight: 900;

  letter-spacing: 2px;

  transition:
    transform 0.12s ease,
    box-shadow 0.12s ease;
}

.terminal-badge:hover {
  transform: translate(-2px, -2px);

  box-shadow:
    6px 6px 0 #111;
}

.terminal-badge span {
  width: 11px;
  height: 11px;

  border-radius: 50%;

  background: #79e3a5;

  border: 2px solid #111;
}


/* =========================================================
   HERO TITLE
========================================================= */

.hero-title {
  display: flex;

  align-items: baseline;

  gap: 14px;

  margin-top: 42px;
}

.hero-title h1 {
  font-size: clamp(
    46px,
    8vw,
    78px
  );

  line-height: 0.95;

  font-weight: 900;

  letter-spacing: -5px;
}

.hero-title > span {
  color: #999;

  font-size: 13px;

  font-weight: 800;

  letter-spacing: 2px;
}


/* =========================================================
   DESCRIPTION
========================================================= */

.hero-description {
  max-width: 650px;

  margin-top: 26px;

  color: #333;

  font-size: 18px;

  line-height: 1.75;
}


/* =========================================================
   STATS
========================================================= */

.stats {
  display: grid;

  grid-template-columns: 1fr 1fr;

  margin-top: 48px;

  background: #fff;

  border: 3px solid #111;

  border-radius: 19px;

  box-shadow:
    6px 6px 0 #111;

  overflow: hidden;
}

.stat {
  min-height: 105px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  gap: 8px;

  padding: 22px 28px;
}

.stat + .stat {
  border-left: 3px solid #111;
}

.stat span {
  color: #777;

  font-size: 10px;

  font-weight: 900;

  letter-spacing: 2px;
}

.stat strong {
  font-size: 30px;

  font-weight: 900;
}

.mint-text {
  color: #36a86b;
}


/* =========================================================
   SEARCH
========================================================= */

.search-section {
  margin-top: 55px;

  scroll-margin-top: 100px;
}

.search-box {
  min-height: 64px;

  display: flex;

  align-items: center;

  gap: 14px;

  padding: 8px 14px;

  background: #fff;

  border: 3px solid #111;

  border-radius: 17px;

  box-shadow:
    5px 5px 0 #111;

  transition:
    transform 0.12s ease,
    box-shadow 0.12s ease;
}

.search-box:focus-within {
  transform: translate(-2px, -2px);

  box-shadow:
    7px 7px 0 #111;
}

.search-icon {
  width: 40px;
  height: 40px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #79e3a5;

  border: 2px solid #111;

  border-radius: 11px;

  font-size: 22px;

  font-weight: 900;
}

.search-box input {
  flex: 1;

  min-width: 0;

  height: 42px;

  border: 0;

  outline: 0;

  background: transparent;

  color: #111;

  font-size: 14px;

  font-weight: 600;
}

.search-box input::placeholder {
  color: #999;
}

.clear-search {
  width: 36px;
  height: 36px;

  background: #f1f1e8;

  border: 2px solid #111;

  border-radius: 10px;

  font-size: 21px;

  cursor: pointer;
}


/* =========================================================
   CATEGORIES
========================================================= */

.categories {
  display: flex;

  flex-direction: column;

  gap: 24px;

  margin-top: 32px;
}

.category-card {
  scroll-margin-top: 100px;

  background: #fff;

  border: 3px solid #111;

  border-radius: 22px;

  box-shadow:
    7px 7px 0 #111;

  overflow: hidden;

  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease;
}

.category-card:hover {
  transform: translate(-2px, -2px);

  box-shadow:
    9px 9px 0 #111;
}

.category-card.opened {
  transform: none;

  box-shadow:
    8px 8px 0 #111;
}


/* =========================================================
   CATEGORY HEADER
========================================================= */

.category-top {
  width: 100%;

  min-height: 92px;

  display: flex;

  align-items: center;

  gap: 18px;

  padding: 17px 20px;

  background: #fff;

  border: 0;

  cursor: pointer;

  text-align: left;
}

.category-icon {
  width: 55px;
  height: 55px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  border: 3px solid #111;

  border-radius: 15px;

  box-shadow:
    3px 3px 0 #111;

  font-size: 24px;

  font-weight: 900;
}

.category-icon.mint {
  background: #79e3a5;
}

.category-icon.pink {
  background: #ff9ed1;
}

.category-icon.blue {
  background: #9edaff;
}

.category-icon.purple {
  background: #c5a4ff;
}

.category-icon.orange {
  background: #ffbc71;
}

.category-icon.yellow {
  background: #ffe16a;
}

.category-info {
  min-width: 0;

  flex: 1;
}

.category-info h2 {
  font-size: 20px;

  font-weight: 900;

  letter-spacing: -0.5px;
}

.category-info span {
  display: block;

  margin-top: 5px;

  color: #888;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 2px;
}

.open-label {
  flex-shrink: 0;

  padding: 9px 12px;

  background: #f4f4e9;

  border: 2px solid #111;

  border-radius: 10px;

  box-shadow:
    2px 2px 0 #111;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 1px;
}


/* =========================================================
   CATEGORY PATH
========================================================= */

.category-path {
  margin: 0 20px 18px;

  padding: 10px 13px;

  background: #f4f5e8;

  border: 2px solid #111;

  border-radius: 9px;

  color: #666;

  font-family:
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size: 11px;

  overflow-x: auto;
}


/* =========================================================
   ENDPOINT LIST
========================================================= */

.endpoint-list {
  display: none;

  padding: 0 20px 20px;

  gap: 14px;

  flex-direction: column;
}

.endpoint-list.visible {
  display: flex;
}


/* =========================================================
   ENDPOINT
========================================================= */

.endpoint {
  background: #fafbea;

  border: 3px solid #111;

  border-radius: 16px;

  box-shadow:
    4px 4px 0 #111;

  overflow: hidden;

  transition:
    transform 0.12s ease,
    box-shadow 0.12s ease;
}

.endpoint:hover {
  transform: translate(-1px, -1px);

  box-shadow:
    5px 5px 0 #111;
}

.endpoint-open {
  background: #fff;
}


/* =========================================================
   ENDPOINT HEADER
========================================================= */

.endpoint-header {
  width: 100%;

  min-height: 72px;

  display: flex;

  align-items: center;

  gap: 14px;

  padding: 12px 15px;

  background: transparent;

  border: 0;

  cursor: pointer;

  text-align: left;
}

.method {
  min-width: 55px;

  padding: 7px 8px;

  text-align: center;

  background: #79e3a5;

  border: 2px solid #111;

  border-radius: 8px;

  box-shadow:
    2px 2px 0 #111;

  font-size: 9px;

  font-weight: 900;
}

.endpoint-main {
  flex: 1;

  min-width: 0;

  display: flex;

  flex-direction: column;
}

.endpoint-main strong {
  font-size: 14px;

  font-weight: 900;
}

.endpoint-main span {
  margin-top: 5px;

  color: #777;

  font-family:
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size: 10px;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}

.endpoint-chevron {
  width: 33px;
  height: 33px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #fff;

  border: 2px solid #111;

  border-radius: 9px;

  box-shadow:
    2px 2px 0 #111;

  font-size: 19px;

  font-weight: 700;
}


/* =========================================================
   ENDPOINT BODY
========================================================= */

.endpoint-body {
  padding: 0 15px 17px;

  border-top: 2px solid #111;
}

.endpoint-description {
  padding: 17px 0;

  color: #555;

  font-size: 13px;

  line-height: 1.6;
}


/* =========================================================
   PARAMETERS
========================================================= */

.params {
  display: flex;

  flex-direction: column;

  gap: 13px;
}

.param {
  display: flex;

  flex-direction: column;

  gap: 7px;
}

.param-label {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 10px;
}

.param-label span {
  font-size: 11px;

  font-weight: 900;
}

.param-label small {
  padding: 4px 7px;

  background: #ffb3b3;

  border: 1px solid #111;

  border-radius: 5px;

  font-size: 7px;

  font-weight: 900;
}

.param input {
  width: 100%;

  height: 45px;

  padding: 0 13px;

  background: #fff;

  border: 2px solid #111;

  border-radius: 9px;

  outline: none;

  box-shadow:
    2px 2px 0 #111;

  color: #111;

  font-size: 12px;
}

.param input:focus {
  background: #effff4;

  box-shadow:
    3px 3px 0 #111;
}


/* =========================================================
   EXECUTE
========================================================= */

.execute-button {
  width: 100%;

  min-height: 48px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  margin-top: 18px;

  padding: 10px 18px;

  background: #111;

  color: #fff;

  border: 3px solid #111;

  border-radius: 11px;

  box-shadow:
    4px 4px 0 #79e3a5;

  font-size: 11px;

  font-weight: 900;

  letter-spacing: 1.5px;

  cursor: pointer;

  transition:
    transform 0.12s ease,
    box-shadow 0.12s ease;
}

.execute-button:hover {
  transform: translate(-2px, -2px);

  box-shadow:
    6px 6px 0 #79e3a5;
}

.execute-button:active {
  transform: translate(3px, 3px);

  box-shadow:
    1px 1px 0 #79e3a5;
}

.execute-button:disabled {
  opacity: 0.55;

  cursor: wait;
}


/* =========================================================
   REQUEST URL
========================================================= */

.request-url {
  margin-top: 17px;

  padding: 13px;

  background: #edf9ef;

  border: 2px solid #111;

  border-radius: 10px;
}

.request-url span {
  display: block;

  margin-bottom: 7px;

  color: #555;

  font-size: 8px;

  font-weight: 900;

  letter-spacing: 2px;
}

.request-url code {
  display: block;

  color: #222;

  font-family:
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size: 10px;

  line-height: 1.6;

  word-break: break-all;
}


/* =========================================================
   RESPONSE
========================================================= */

.response-wrapper {
  margin-top: 18px;

  border: 3px solid #111;

  border-radius: 12px;

  overflow: hidden;

  box-shadow:
    4px 4px 0 #111;
}

.response-header {
  min-height: 45px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 10px;

  padding: 8px 12px;

  background: #111;

  color: #fff;
}

.response-header > span {
  font-size: 9px;

  font-weight: 900;

  letter-spacing: 2px;
}

.response-header > div {
  display: flex;

  align-items: center;

  gap: 8px;
}

.response-header small {
  padding: 4px 7px;

  background: #333;

  border-radius: 5px;

  font-size: 8px;

  font-weight: 800;
}

.response-header small.success {
  background: #79e3a5;

  color: #111;
}

.response-header small.error {
  background: #ff8f8f;

  color: #111;
}

.response {
  max-height: 500px;

  margin: 0;

  padding: 15px;

  background: #171717;

  color: #d9f9e3;

  font-family:
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size: 11px;

  line-height: 1.65;

  overflow: auto;

  white-space: pre-wrap;

  word-break: break-word;
}


/* =========================================================
   EMPTY
========================================================= */

.empty {
  padding: 55px 25px;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  gap: 10px;

  background: #fff;

  border: 3px solid #111;

  border-radius: 20px;

  box-shadow:
    6px 6px 0 #111;

  text-align: center;
}

.empty strong {
  font-size: 18px;

  font-weight: 900;
}

.empty span {
  color: #777;

  font-size: 13px;
}


/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

::-webkit-scrollbar-track {
  background: #e9eadc;
}

::-webkit-scrollbar-thumb {
  background: #111;

  border-radius: 10px;

  border: 2px solid #e9eadc;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

  .header {
    height: 70px;
  }

  .header-inner {
    padding: 0 16px;
  }

  .menu-button {
    width: 43px;
    height: 43px;

    border-radius: 12px;

    box-shadow:
      3px 3px 0 #111;
  }

  .menu-button span {
    width: 20px;
    height: 3px;
  }


  .side-nav {
    width: 340px;

    max-width: 88vw;

    padding: 25px 17px;
  }

  .side-nav-header h2 {
    font-size: 21px;
  }

  .close-button {
    width: 43px;
    height: 43px;

    font-size: 26px;

    border-radius: 12px;

    box-shadow:
      3px 3px 0 #111;
  }

  .nav-items {
    gap: 10px;

    padding-top: 20px;
  }

  .nav-item {
    min-height: 55px;

    padding: 11px 13px;

    border-radius: 14px;

    box-shadow:
      3px 3px 0 #111;
  }

  .nav-item b {
    font-size: 11px;
  }

  .nav-item > span {
    font-size: 17px;
  }


  .main {
    width: calc(100% - 28px);

    padding: 45px 0 70px;
  }


  .terminal-badge {
    padding: 8px 13px;

    font-size: 9px;

    box-shadow:
      3px 3px 0 #111;
  }

  .terminal-badge span {
    width: 9px;
    height: 9px;
  }


  .hero-title {
    gap: 10px;

    margin-top: 35px;
  }

  .hero-title h1 {
    font-size: 48px;

    letter-spacing: -3px;
  }

  .hero-title > span {
    font-size: 10px;
  }


  .hero-description {
    margin-top: 20px;

    font-size: 14px;

    line-height: 1.7;
  }


  .stats {
    margin-top: 32px;

    border-radius: 15px;

    box-shadow:
      4px 4px 0 #111;
  }

  .stat {
    min-height: 82px;

    padding: 15px;
  }

  .stat strong {
    font-size: 23px;
  }

  .stat span {
    font-size: 8px;
  }


  .search-section {
    margin-top: 38px;
  }

  .search-box {
    min-height: 55px;

    border-radius: 14px;

    box-shadow:
      4px 4px 0 #111;
  }

  .search-icon {
    width: 34px;
    height: 34px;

    font-size: 18px;
  }

  .search-box input {
    font-size: 12px;
  }


  .categories {
    gap: 18px;

    margin-top: 25px;
  }

  .category-card {
    border-radius: 17px;

    box-shadow:
      5px 5px 0 #111;
  }

  .category-card:hover {
    transform: none;

    box-shadow:
      5px 5px 0 #111;
  }

  .category-top {
    min-height: 75px;

    gap: 11px;

    padding: 12px;
  }

  .category-icon {
    width: 43px;
    height: 43px;

    border-radius: 11px;

    font-size: 18px;

    box-shadow:
      2px 2px 0 #111;
  }

  .category-info h2 {
    font-size: 15px;
  }

  .category-info span {
    margin-top: 3px;

    font-size: 7px;

    letter-spacing: 1.5px;
  }

  .open-label {
    padding: 6px 7px;

    font-size: 7px;

    border-radius: 7px;

    box-shadow:
      2px 2px 0 #111;
  }

  .category-path {
    margin: 0 12px 13px;

    padding: 8px 10px;

    font-size: 8px;
  }


  .endpoint-list {
    padding: 0 12px 13px;

    gap: 11px;
  }

  .endpoint {
    border-radius: 13px;

    box-shadow:
      3px 3px 0 #111;
  }

  .endpoint-header {
    min-height: 61px;

    gap: 9px;

    padding: 9px;
  }

  .method {
    min-width: 47px;

    padding: 6px 5px;

    font-size: 7px;
  }

  .endpoint-main strong {
    font-size: 11px;
  }

  .endpoint-main span {
    margin-top: 3px;

    font-size: 8px;
  }

  .endpoint-chevron {
    width: 28px;
    height: 28px;

    font-size: 16px;
  }


  .endpoint-body {
    padding: 0 10px 12px;
  }

  .endpoint-description {
    padding: 13px 0;

    font-size: 11px;
  }

  .param-label span {
    font-size: 9px;
  }

  .param-label small {
    font-size: 6px;
  }

  .param input {
    height: 40px;

    padding: 0 10px;

    font-size: 10px;
  }

  .execute-button {
    min-height: 43px;

    margin-top: 14px;

    font-size: 9px;

    box-shadow:
      3px 3px 0 #79e3a5;
  }

  .request-url {
    padding: 10px;
  }

  .request-url code {
    font-size: 8px;
  }

  .response {
    max-height: 400px;

    padding: 11px;

    font-size: 8px;
  }

  .response-header {
    min-height: 39px;

    padding: 7px 9px;
  }

  .response-header > span {
    font-size: 7px;
  }

  .response-header small {
    font-size: 7px;
  }
}


/* =========================================================
   VERY SMALL PHONE
========================================================= */

@media (max-width: 380px) {

  .main {
    width: calc(100% - 22px);
  }

  .hero-title h1 {
    font-size: 42px;
  }

  .category-top {
    padding: 10px;
  }

  .category-icon {
    width: 39px;
    height: 39px;
  }

  .open-label {
    display: none;
  }

  .stat {
    padding: 12px;
  }

  .stat strong {
    font-size: 21px;
  }
}
